# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Atlas Connection URI
MONGODB_URI="mongodb+srv://user:pass@cluster0.mongodb.net/dracin_db?retryWrites=true&w=majority"

# Sansekai API Base URL
SANSEKAI_BASE_URL="https://api.sansekai.my.id/api"

# ==========================================
# ☁️ GOOGLE DRIVE AUTO-BACKUP CREDENTIALS
# ==========================================
GDRIVE_CLIENT_ID="MY_GDRIVE_CLIENT_ID"
GDRIVE_CLIENT_SECRET="MY_GDRIVE_CLIENT_SECRET"
GDRIVE_REFRESH_TOKEN="MY_GDRIVE_REFRESH_TOKEN"
GDRIVE_REDIRECT_URI="https://developers.google.com/oauthplayground"
GDRIVE_ROOT_FOLDER_ID="MY_ROOT_FOLDER_ID"
